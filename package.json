{
  "name": "@lostgradient/bun-plugin-svelte",
  "version": "0.0.1",
  "description": "Bun bundler and runtime plugin for Svelte 5 components and rune modules — client and SSR compilation, CSS modes, and dev-server HMR.",
  "keywords": [
    "bun",
    "bun-plugin",
    "svelte",
    "svelte5",
    "hmr",
    "ssr",
    "bundler"
  ],
  "homepage": "https://github.com/stevekinney/bun-plugin-svelte#readme",
  "bugs": "https://github.com/stevekinney/bun-plugin-svelte/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevekinney/bun-plugin-svelte.git"
  },
  "license": "MIT",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "clean": "rm -rf dist coverage node_modules/.cache/tsconfig.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo",
    "dev": "bun test --watch",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "prepack": "bun run build",
    "package:check": "bun run scripts/check-package.ts",
    "preflight:publish": "bun run scripts/preflight-publish.ts",
    "prepare": "bun x lefthook install",
    "prepublishOnly": "bun run preflight:publish && bun run validate",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:test && bun run test && bun run build && bun run package:check && bun run verify:package-types && bun run verify:scaffold",
    "verify:package-types": "bun run scripts/verify-package-types.ts",
    "verify:release-version": "bun run scripts/verify-release-version.ts",
    "verify:scaffold": "bun run scripts/verify-scaffold-replaced.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "chalk": "^5.6.2",
    "change-case": "^5.4.4",
    "lefthook": "^2.1.10",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "sort-package-json": "^4.0.0",
    "svelte": "~5.56.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@types/bun": "*",
    "svelte": ">=5.0.0 <6"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
