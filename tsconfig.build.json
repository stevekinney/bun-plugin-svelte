{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "allowImportingTsExtensions": false,
    "incremental": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "stripInternal": true,
    // This package's public API is Bun-typed by design (BunPlugin,
    // Bun.Transpiler), so the declaration emit deliberately includes
    // @types/bun — consumers get it via the optional @types/bun peer.
    "types": ["bun"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
